DATABASE_URL=postgresql://usuario:senha@host/db?sslmode=require

# Origens do front permitidas no CORS, separadas por vírgula (padrão: localhost:5500)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# E-mails aceitos no cadastro (padrão: UNDB). Domínio comparado por igualdade exata.
EMAIL_DOMINIO_ALUNO=aluno.undb.edu.br
EMAIL_PREFIXO_ALUNO=002-02
EMAIL_DOMINIOS_PROFESSOR=undb.edu.br

# Recuperação de senha
# Segredo que assina os links (gere um valor longo e aleatório). Sem ele, os links caem ao reiniciar o servidor.
RESET_SECRET=troque-por-um-valor-longo-e-aleatorio
RESET_TTL_MINUTOS=30
FRONT_URL=http://localhost:5500
# SMTP para enviar o e-mail de verdade. Sem SMTP_HOST (dev), o link aparece no log do uvicorn.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
