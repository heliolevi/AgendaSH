DATABASE_URL=postgresql://usuario:senha@host/db?sslmode=require

# Origens do front permitidas no CORS, separadas por vírgula (padrão: localhost:5500)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# E-mails aceitos no cadastro (padrão: UNDB). Domínio comparado por igualdade exata.
EMAIL_DOMINIO_ALUNO=aluno.undb.edu.br
EMAIL_PREFIXO_ALUNO=002-02
EMAIL_DOMINIOS_PROFESSOR=undb.edu.br

# Código por e-mail (cadastro e recuperação de senha). Sem SMTP_HOST o envio falha (503) e ninguém cria conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 1 = STARTTLS (porta 587) · ssl = SSL direto (porta 465) · 0 = sem criptografia
SMTP_TLS=1
# Segredo que protege os códigos guardados no banco (valor longo e aleatório; sem ele os códigos pendentes caem ao reiniciar)
CODIGO_SECRET=
CODIGO_TTL_MINUTOS=10
# SÓ desenvolvimento: 1 escreve o código no log em vez de enviar o e-mail. Nunca em produção.
CODIGO_NO_LOG=0

# Agenda
APP_TIMEZONE=America/Fortaleza
# Semanas à frente que as reuniões fixas são geradas (renovadas de hora em hora)
FIXAS_SEMANAS=8
# Limpeza automática de reuniões e eventos de dias passados (0 desliga) e intervalo em minutos
LIMPEZA_REUNIOES=1
LIMPEZA_INTERVALO_MIN=60

# --- Autenticacao por token (JWT) ---
# Segredo que assina os tokens de login. Gere um valor longo e aleatorio e NUNCA comite.
# Ex. (PowerShell): python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Validade do token de login, em minutos (padrao 720 = 12h).
JWT_EXPIRA_MIN=720
